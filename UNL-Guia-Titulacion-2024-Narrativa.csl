<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       class="in-text"
       default-locale="es-ES">

  <info>
    <title>UNL APA 7 Español con Y</title>
    <id>http://www.zotero.org/styles/unl-apa-7-es-y</id>
    <link href="http://www.zotero.org/styles/unl-apa-7-es-y" rel="self"/>
    <link href="http://www.zotero.org/styles/apa" rel="template"/>
    <category citation-format="author-date"/>
    <summary>APA 7 adaptado a la guía UNL 2024 con conjunción y.</summary>
    <updated>2026-11-24T00:00:00+00:00</updated>
  </info>

  <locale xml:lang="es">
    <terms>
      <term name="and">y</term>
      <term name="et-al">et al.</term>
      <term name="no date">s. f.</term>
      <term name="page" form="short">p.</term>
      <term name="pages" form="short">pp.</term>
      <term name="editor" form="short">
        <single>Ed.</single>
        <multiple>Eds.</multiple>
      </term>
    </terms>
  </locale>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            initialize-with=". "
            delimiter=", "
            and="text"
            delimiter-precedes-last="always"/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all"
                initialize-with=". "
                delimiter=", "
                and="text"/>
        </names>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-short">
    <names variable="author">
      <name form="short" and="text" delimiter=", "/>
      <et-al/>
      <substitute>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>

  <macro name="date">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date"/>
      </else>
    </choose>
  </macro>

  <citation et-al-min="3"
            et-al-use-first="1"
            disambiguate-add-year-suffix="true">
    <sort>
      <key macro="author-short"/>
      <key macro="date"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-short"/>
        <text macro="date"/>
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true"
                et-al-min="21"
                et-al-use-first="19"
                entry-spacing="0"
                line-spacing="2">
    <sort>
      <key macro="author"/>
      <key macro="date"/>
      <key variable="title"/>
    </sort>
    <layout>
      <group delimiter=" ">
        <text macro="author"/>
        <group prefix="(" suffix=").">
          <text macro="date"/>
        </group>

        <choose>
          <if type="article-journal article-magazine article-newspaper" match="any">
            <text variable="title" suffix="."/>
            <group delimiter=", ">
              <text variable="container-title" font-style="italic"/>
              <group>
                <text variable="volume" font-style="italic"/>
                <text variable="issue" prefix="(" suffix=")"/>
              </group>
              <text variable="page"/>
            </group>
            <choose>
              <if variable="DOI">
                <text variable="DOI" prefix=". https://doi.org/"/>
              </if>
              <else-if variable="URL">
                <text variable="URL" prefix=". "/>
              </else-if>
            </choose>
          </if>

          <else-if type="thesis">
            <text variable="title" font-style="italic" suffix="."/>
            <group prefix="[" suffix="]" delimiter=", ">
              <text variable="genre"/>
              <text variable="publisher"/>
            </group>
            <text variable="URL" prefix=". "/>
          </else-if>

          <else-if type="webpage">
            <text variable="title" font-style="italic" suffix="."/>
            <text variable="container-title" prefix=" "/>
            <text variable="URL" prefix=". "/>
          </else-if>

          <else>
            <text variable="title" font-style="italic" suffix="."/>
            <text variable="edition" prefix=" (" suffix=")."/>
            <text variable="publisher"/>
            <choose>
              <if variable="DOI">
                <text variable="DOI" prefix=". https://doi.org/"/>
              </if>
              <else-if variable="URL">
                <text variable="URL" prefix=". "/>
              </else-if>
            </choose>
          </else>
        </choose>
      </group>
    </layout>
  </bibliography>
</style>
